# BEGIN Force HTTPS
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>
# END Force HTTPS

# BEGIN WordPress
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteRule ^index\.php$ - [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . /index.php [L]
</IfModule>
# END WordPress

ErrorDocument 404 /index.php

# BEGIN Durcissement sécurité
# Pas de listing de répertoire si un dossier n'a pas d'index.
Options -Indexes

# Bloque l'accès direct aux fichiers sensibles (config, dépôt git, éditeurs...).
<FilesMatch "^(wp-config\.php|\.htaccess|\.htpasswd|readme\.html|license\.txt)$">
  Require all denied
</FilesMatch>
<FilesMatch "^\.(git|env)">
  Require all denied
</FilesMatch>

# XML-RPC est déjà désactivé côté WordPress (filtre xmlrpc_enabled) ; on bloque
# aussi l'accès au fichier lui-même en défense en profondeur.
<Files "xmlrpc.php">
  Require all denied
</Files>

# N'exécute pas de PHP dans le dossier des médias uploadés (empêche l'exécution
# d'un script si un fichier malveillant y était un jour déposé).
<IfModule mod_php.c>
  <Directory "wp-content/uploads">
    php_flag engine off
  </Directory>
</IfModule>
<FilesMatch "\.(php|phtml|php\d)$">
  <If "%{REQUEST_URI} =~ m#^/wp-content/uploads/#">
    Require all denied
  </If>
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=(), payment=(), browsing-topics=()"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header unset X-Powered-By

  # Content-Security-Policy — liste blanche des seuls services externes
  # réellement appelés par le thème (voir rando_nono_assets() et les scripts
  # dans assets/js/) : tuiles OpenStreetMap, météo Open-Meteo, et Google
  # Analytics / pixel Facebook, chargés uniquement si configurés depuis
  # l'admin et seulement après consentement (voir rando_nono_ga_assets()).
  # 'unsafe-inline' reste nécessaire en l'absence d'étape de build (pas de
  # nonce ni de hash à régénérer à chaque modification du thème) ; en
  # contrepartie, object-src/base-uri/form-action/frame-ancestors sont
  # verrouillés. Dupliquée en PHP (rando_nono_security_headers) comme filet
  # de sécurité si mod_headers est indisponible — garder les deux synchronisées.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.tile.openstreetmap.org https://www.facebook.com; font-src 'self' data:; connect-src 'self' https://api.open-meteo.com https://*.google-analytics.com https://*.analytics.google.com https://www.facebook.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>
ServerSignature Off
# END Durcissement sécurité

# BEGIN Cache navigateur
# Les fichiers versionnés par date de modification (voir rando_nono_asset_ver()
# dans functions.php) peuvent être mis en cache longtemps sans risque : toute
# modification change l'URL, forçant un rechargement.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(jpe?g|png|webp|svg|ico|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
# END Cache navigateur

# BEGIN Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
# END Compression
