{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(**/assets/vendor/**)",
      "Read(./assets/vendor/**)",
      "Read(**/assets/fonts/**)",
      "Read(./assets/fonts/**)"
    ],
    "allow": [
      "Bash(php -l *)",
      "Bash(node --check *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(wc *)",
      "Bash(sed -n *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(md5sum *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ]
  }
}
