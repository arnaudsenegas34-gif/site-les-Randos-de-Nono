{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./assets/vendor/leaflet/leaflet.js)",
      "Read(./assets/vendor/chartjs/chart.umd.min.js)",
      "Read(**/assets/vendor/leaflet/leaflet.js)",
      "Read(**/assets/vendor/chartjs/chart.umd.min.js)"
    ],
    "allow": [
      "Bash(php -l *)",
      "Bash(node --check *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(wc *)",
      "Bash(sed -n *)",
      "Bash(md5sum *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)"
    ]
  }
}
